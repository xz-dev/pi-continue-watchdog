{
  "name": "pi-continue-watchdog",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Continue-watchdog extension for Pi with a watchdog-owned continue/unlock decision inquiry and automatic continuation.",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xz-dev/pi-continue-watchdog.git"
  },
  "homepage": "https://github.com/xz-dev/pi-continue-watchdog#readme",
  "bugs": {
    "url": "https://github.com/xz-dev/pi-continue-watchdog/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "continue",
    "watchdog",
    "agent"
  ],
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "files": [
    "src",
    "docs",
    "patches",
    "scripts",
    "LICENSE",
    "README.md"
  ],
  "bundledDependencies": [
    "watchdog-subagents-runtime"
  ],
  "scripts": {
    "postinstall": "node scripts/prepare-private-runtime.mjs",
    "prepack": "node scripts/prepare-private-runtime.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "biome check src test",
    "format": "biome format --write src test",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "test:e2e:packed": "tsx --test test/e2e/packed.test.ts",
    "test:e2e:cross-process": "tsx --test test/e2e/cross-process.test.ts",
    "test:e2e:native-summary": "tsx --test test/e2e/native-summary.test.ts",
    "test:e2e": "npm run test:e2e:packed && npm run test:e2e:cross-process && npm run test:e2e:native-summary"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.3.0",
    "@earendil-works/pi-tui": ">=1.3.0",
    "typebox": "*"
  },
  "dependencies": {
    "pi-extension-utils": "git+https://github.com/xz-dev/pi-extension-utils.git#210f84e",
    "watchdog-subagents-runtime": "git+https://github.com/nicobailon/pi-subagents.git#1008e5993e90fcf13b815c97c15a0c54f7f6f116"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "^26.5.0",
    "tsx": "^4.23.13",
    "typebox": "1.3.7",
    "typescript": "^7.0.2"
  }
}
