{
  "name": "pi-continue-watchdog",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Continue-watchdog extension for Pi (two-stage idle decision flow).",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xz-dev/pi-continue-watchdog.git"
  },
  "homepage": "https://github.com/xz-dev/pi-continue-watchdog#readme",
  "bugs": {
    "url": "https://github.com/xz-dev/pi-continue-watchdog/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "continue",
    "watchdog",
    "agent"
  ],
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "files": [
    "src",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "biome check src test",
    "format": "biome format --write src test",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "test:e2e": "tsx --test test/e2e/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "@types/node": "^26.1.2",
    "tsx": "^4.20.6",
    "typebox": "^1.3.9",
    "typescript": "^7.0.2"
  }
}
