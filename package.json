{
  "name": "pi-continue-watchdog",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Continue-watchdog extension for Pi (two-stage idle decision flow).",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xz-dev/pi-continue-watchdog.git"
  },
  "homepage": "https://github.com/xz-dev/pi-continue-watchdog#readme",
  "bugs": {
    "url": "https://github.com/xz-dev/pi-continue-watchdog/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "continue",
    "watchdog",
    "agent"
  ],
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "files": [
    "src",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "biome check src test",
    "format": "biome format --write src test",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "test:e2e:packed": "tsx --test test/e2e/packed.test.ts",
    "test:e2e:cross-process": "tsx --test test/e2e/cross-process.test.ts",
    "test:e2e": "npm run test:e2e:packed && npm run test:e2e:cross-process"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "pi-process-domain": "git+https://github.com/xz-dev/pi-process-domain.git#592d7ddb55091649116c916ed3c1e25e23d989aa"
  },
  "allowScripts": {
    "pi-process-domain": true
  }
}
